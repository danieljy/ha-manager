# ha-manager instance file — TEMPLATE. Copy once per Home Assistant instance:
#
#   cp instances/example.env instances/prox.env
#   cp instances/example.env instances/pi.env
#   chmod 600 instances/*.env
#
# The file name minus ".env" is the instance name the scripts take:
#
#   bin/ha-api -i prox GET /api/config
#
# Everything in instances/ except this template is gitignored. These files
# hold a bearer token: never commit them, never paste them into a chat,
# never cat them into a transcript.
#
# Format: KEY="value", one per line. The scripts parse this file rather than
# sourcing it, so it cannot run commands, and only the HA_* keys below are
# read — anything else is ignored with a warning.

# Short human label. Shown by ha-ls and in the "[ha] instance:" line every
# script prints on stderr.
HA_LABEL="Proxmox VM"

# Base URL: scheme + host + port, no trailing slash. Prefer the Tailscale
# MagicDNS name (or Tailscale IP) so the URL works from any network you
# happen to be on, not just this instance's LAN.
HA_URL="http://prox.your-tailnet.ts.net:8123"

# Long-lived access token.
#
# Create a DEDICATED user for this tooling on each instance
# (Settings → People → Add person → "Allow login", make it an administrator —
# the Supervisor endpoints require admin), sign in AS THAT USER, and create
# the token from its profile (Profile → Security → Long-lived access tokens).
#
# Why a separate user:
#   - you can revoke the token (or delete the user) without logging yourself
#     out of anything
#   - the logbook attributes every change made through this tooling to that
#     user, so agent actions are distinguishable from yours
HA_TOKEN="paste-token-here"

# ~/.ssh/config Host alias for this instance's SSH add-on. ALIAS ONLY: the
# hostname, port, user and IdentityFile live in ~/.ssh/config, never here.
#
#   Host ha-prox
#       HostName prox.your-tailnet.ts.net
#       Port 22
#       User root
#       IdentityFile ~/.ssh/id_ed25519
HA_SSH_HOST="ha-prox"

# Local mount point of this instance's Samba "config" share (SETUP-HAOS.md).
# Both instances export a share called "config", so give each its own
# directory. "~/" is expanded; other shell variables are not.
HA_MOUNT="~/mnt/ha-prox"

# Install type: os | supervised | container | core
# Leave it as is and run `bin/ha-detect -i <name>` to have it worked out.
HA_INSTALL_TYPE="os"

# Protected flag: true | false
# When true, every state-changing operation — REST writes, and anything over
# ssh that restarts, reloads, stops, updates, deletes or overwrites — is
# refused unless the command is run with --yes. Set it on the instance you
# can't walk over to and fix.
HA_PROTECTED="false"
